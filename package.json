{
  "name": "capybara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @capybara/desktop dev",
    "build": "pnpm --filter @capybara/desktop build",
    "test": "pnpm --filter @capybara/desktop test",
    "lint": "pnpm --filter @capybara/desktop lint",
    "typecheck": "pnpm --filter @capybara/desktop typecheck",
    "tauri": "pnpm --filter @capybara/desktop tauri",
    "tauri:dev": "pnpm --filter @capybara/desktop tauri dev",
    "tauri:build": "pnpm --filter @capybara/desktop tauri build"
  }
}

