# Copy this file to keystore.properties (same directory) and fill in real
# values. keystore.properties and the .jks are git-ignored.
#
# Create a key once with:
#   keytool -genkeypair -v -keystore F:\codex-install\flowproxy-keystore\flowproxy-release.jks \
#     -alias flowproxy -keyalg RSA -keysize 4096 -validity 10000
#
# Keep this certificate for every future release: Android only accepts updates
# signed with the same key.

storeFile=F:\\codex-install\\flowproxy-keystore\\flowproxy-release.jks
storePassword=change-me
keyAlias=flowproxy
keyPassword=change-me
